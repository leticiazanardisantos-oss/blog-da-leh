/* =========================================
   CONFIGURAÇÕES GERAIS
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {

    --vinho: #7b1737;
    --vinho-escuro: #3b071b;
    --vinho-claro: #a92752;

    --rosa: #e66b96;
    --rosa-claro: #ffabc6;

    --roxo: #54206f;

    --preto: #090509;
    --preto2: #130911;

    --branco: #fff8fb;
    --cinza: #d3bdc6;
}

body {

    background: var(--preto);
    color: var(--branco);

    font-family: "Poppins", sans-serif;

    overflow-x: hidden;
}


/* =========================================
   SLIDES
========================================= */

.slide {

    min-height: 100vh;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 80px 10%;

    overflow: hidden;
}


/* =========================================
   SLIDE 1
========================================= */

.slide1 {

    background:

        radial-gradient(
            circle at 80% 30%,
            rgba(230, 107, 150, .35),
            transparent 25%
        ),

        radial-gradient(
            circle at 20% 80%,
            rgba(123, 23, 55, .4),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #090509,
            #3b071b,
            #130911
        );
}


.slide1 .conteudo {

    max-width: 700px;

    z-index: 2;
}


.subtitulo {

    color: var(--rosa);

    font-size: 12px;

    font-weight: 600;

    letter-spacing: 4px;

    margin-bottom: 20px;
}


h1 {

    font-family: "DM Serif Display", serif;

    font-size: clamp(55px, 7vw, 95px);

    line-height: .95;

    font-weight: 400;
}


h1 span {

    display: block;

    color: var(--rosa);

    font-style: italic;

    margin-top: 10px;
}


.descricao {

    color: var(--cinza);

    max-width: 570px;

    line-height: 1.8;

    margin: 30px 0;
}


/* BOTÃO */

.botao {

    display: inline-block;

    padding: 14px 28px;

    background: var(--vinho);

    color: white;

    text-decoration: none;

    border-radius: 50px;

    font-size: 14px;

    font-weight: 500;

    border: 1px solid var(--rosa);

    transition: .3s;
}


.botao:hover {

    background: var(--rosa);

    color: var(--preto);

    transform: translateY(-5px);

    box-shadow: 0 10px 30px rgba(230,107,150,.3);
}


/* =========================================
   DECORAÇÕES
========================================= */

.decoracao {

    position: absolute;

    right: 5%;

    width: 450px;

    height: 450px;
}


.circulo {

    position: absolute;

    border-radius: 50%;
}


.circulo1 {

    width: 350px;
    height: 350px;

    right: 20px;
    top: 50px;

    background:

        linear-gradient(
            135deg,
            var(--vinho-claro),
            var(--roxo)
        );

    box-shadow:

        0 0 80px rgba(230,107,150,.25),

        inset -20px -20px 60px rgba(0,0,0,.3);
}


.circulo2 {

    width: 170px;
    height: 170px;

    right: 0;
    top: 0;

    background: var(--rosa);

    opacity: .6;

    filter: blur(3px);
}


.estrela {

    position: absolute;

    left: 30px;
    bottom: 50px;

    color: var(--rosa-claro);

    font-size: 80px;

    animation: girar 8s linear infinite;
}


@keyframes girar {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}


/* =========================================
   NÚMERO DOS SLIDES
========================================= */

.numero {

    position: absolute;

    top: 40px;
    right: 8%;

    font-size: 13px;

    letter-spacing: 3px;

    color: var(--rosa);

    opacity: .7;
}


/* =========================================
   SLIDE 2
========================================= */

.slide2 {

    background:

        radial-gradient(
            circle at 90% 90%,
            rgba(84,32,111,.5),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #10070d,
            #3b071b
        );

    flex-direction: column;
}


.titulo {

    width: 100%;

    max-width: 1100px;

    margin-bottom: 50px;
}


.titulo h2 {

    font-family: "DM Serif Display", serif;

    font-size: 65px;

    font-weight: 400;
}


.titulo h2 span {

    color: var(--rosa);

    font-style: italic;
}


.sobre-box {

    width: 100%;

    max-width: 1100px;

    display: grid;

    grid-template-columns: 350px 1fr;

    gap: 80px;

    align-items: center;
}


/* FOTO */

.foto {

    width: 300px;
    height: 380px;

    background:

        linear-gradient(
            145deg,
            var(--vinho-claro),
            var(--roxo),
            var(--vinho-escuro)
        );

    border-radius: 150px 150px 20px 20px;

    display: flex;

    align-items: center;
    justify-content: center;

    border: 3px solid rgba(255,255,255,.1);

    box-shadow:

        20px 20px 0 rgba(230,107,150,.15),

        0 20px 70px rgba(0,0,0,.4);
}


.foto span {

    font-family: "DM Serif Display", serif;

    font-size: 190px;

    color: rgba(255,255,255,.15);
}


.texto h3 {

    font-family: "DM Serif Display", serif;

    font-size: 38px;

    margin-bottom: 20px;
}


.texto p {

    color: var(--cinza);

    line-height: 1.8;

    margin-bottom: 18px;
}


.texto strong {

    color: var(--rosa);
}


/* =========================================
   SLIDE 3 - MÚSICA
========================================= */

.slide3 {

    background:

        radial-gradient(
            circle at 30% 50%,
            rgba(169,39,82,.4),
            transparent 35%
        ),

        linear-gradient(
            120deg,
            #080508,
            #260b18,
            #4c1230
        );
}


.musica-conteudo {

    width: 100%;

    max-width: 950px;

    z-index: 2;
}


.musica-conteudo h2 {

    font-family: "DM Serif Display", serif;

    font-size: 70px;

    font-weight: 400;

    margin-bottom: 45px;
}


.musica-conteudo h2 span {

    color: var(--rosa);

    font-style: italic;
}


.musica-card {

    max-width: 750px;

    display: flex;

    gap: 30px;

    align-items: center;

    padding: 35px;

    margin-bottom: 35px;

    background: rgba(255,255,255,.06);

    border: 1px solid rgba(230,107,150,.3);

    border-radius: 20px;

    backdrop-filter: blur(10px);
}


.icone-musica {

    min-width: 100px;

    height: 100px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:

        linear-gradient(
            135deg,
            var(--rosa),
            var(--vinho)
        );

    font-size: 55px;

    color: white;
}


.mini {

    color: var(--rosa);

    font-size: 10px;

    letter-spacing: 3px;

    margin-bottom: 5px;
}


.musica-card h3 {

    font-family: "DM Serif Display", serif;

    font-size: 45px;

    color: white;
}


.musica-card p {

    color: var(--cinza);

    line-height: 1.7;
}


.musica-card strong {

    color: var(--rosa-claro);
}


/* ONDAS */

.ondas {

    position: absolute;

    bottom: 0;
    right: 10%;

    height: 180px;

    display: flex;

    align-items: flex-end;

    gap: 8px;
}


.ondas span {

    width: 12px;

    background: var(--rosa);

    border-radius: 20px 20px 0 0;

    animation: onda 1s infinite alternate;
}


.ondas span:nth-child(1) {
    height: 50px;
}

.ondas span:nth-child(2) {
    height: 100px;
    animation-delay: .1s;
}

.ondas span:nth-child(3) {
    height: 70px;
    animation-delay: .2s;
}

.ondas span:nth-child(4) {
    height: 140px;
    animation-delay: .3s;
}

.ondas span:nth-child(5) {
    height: 90px;
    animation-delay: .4s;
}

.ondas span:nth-child(6) {
    height: 160px;
    animation-delay: .5s;
}

.ondas span:nth-child(7) {
    height: 80px;
    animation-delay: .6s;
}

.ondas span:nth-child(8) {
    height: 130px;
    animation-delay: .7s;
}


@keyframes onda {

    from {
        transform: scaleY(.5);
    }

    to {
        transform: scaleY(1);
    }
}


/* =========================================
   SLIDE 4 - FILMES
========================================= */

.slide4 {

    flex-direction: column;

    background:

        radial-gradient(
            circle at 50% 100%,
            rgba(123,23,55,.6),
            transparent 40%
        ),

        #0d070b;
}


.centralizado {

    text-align: center;
}


.centralizado .descricao {

    margin: 15px auto 0;
}


.filmes {

    width: 100%;

    max-width: 950px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;

    margin-bottom: 40px;
}


.filme-card {

    min-height: 300px;

    padding: 40px;

    border-radius: 25px;

    position: relative;

    overflow: hidden;

    border: 1px solid rgba(255,255,255,.1);

    transition: .4s;
}


.filme-card:hover {

    transform: translateY(-10px);

    box-shadow: 0 20px 50px rgba(0,0,0,.5);
}


.acao {

    background:

        linear-gradient(
            135deg,
            #65132e,
            #250814
        );
}


.romance {

    background:

        linear-gradient(
            135deg,
            #a92752,
            #54206f
        );
}


.filme-icone {

    font-size: 50px;

    margin-bottom: 20px;
}


.filme-card h3 {

    font-family: "DM Serif Display", serif;

    font-size: 45px;

    margin-bottom: 15px;
}


.filme-card p {

    color: #f1dce4;

    line-height: 1.7;
}


/* =========================================
   SLIDE 5
========================================= */

.slide5 {

    background:

        radial-gradient(
            circle at center,
            #791c3d,
            #260914 50%,
            #080508 100%
        );
}


.final {

    text-align: center;

    max-width: 800px;
}


.aspas {

    font-family: "DM Serif Display", serif;

    font-size: 130px;

    color: var(--rosa);

    height: 100px;
}


.final h2 {

    font-family: "DM Serif Display", serif;

    font-size: 70px;

    font-weight: 400;
}


.final h2 span {

    color: var(--rosa);

    font-style: italic;
}


.final p {

    color: var(--cinza);

    font-size: 18px;

    margin: 25px auto;

    line-height: 1.7;
}


.linha {

    width: 100px;

    height: 2px;

    background: var(--rosa);

    margin: 30px auto;
}


.final h3 {

    font-family: "DM Serif Display", serif;

    font-size: 28px;

    margin-bottom: 30px;
}


/* =========================================
   MENU DE NAVEGAÇÃO
========================================= */

.navegacao {

    position: fixed;

    right: 25px;

    top: 50%;

    transform: translateY(-50%);

    z-index: 100;

    display: flex;

    flex-direction: column;

    gap: 12px;
}


.navegacao a {

    width: 38px;
    height: 38px;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    color: white;

    text-decoration: none;

    font-size: 10px;

    border: 1px solid rgba(255,255,255,.3);

    background: rgba(123,23,55,.6);

    backdrop-filter: blur(5px);

    transition: .3s;
}


.navegacao a:hover {

    background: var(--rosa);

    color: var(--preto);

    transform: scale(1.15);
}


/* =========================================
   RESPONSIVIDADE
========================================= */

@media (max-width: 900px) {

    .decoracao {

        opacity: .25;

        right: -100px;
    }


    .sobre-box {

        grid-template-columns: 1fr;

        gap: 50px;

        text-align: center;
    }


    .foto {

        margin: auto;
    }


    .titulo {

        text-align: center;
    }


    .filmes {

        grid-template-columns: 1fr;
    }


    .ondas {

        opacity: .15;
    }
}


@media (max-width: 600px) {

    .slide {

        padding: 80px 7%;
    }


    h1 {

        font-size: 55px;
    }


    .titulo h2,
    .musica-conteudo h2,
    .final h2 {

        font-size: 48px;
    }


    .foto {

        width: 240px;
        height: 300px;
    }


    .foto span {

        font-size: 140px;
    }


    .musica-card {

        flex-direction: column;

        text-align: center;
    }


    .filme-card {

        min-height: 250px;

        padding: 30px;
    }


    .navegacao {

        right: 10px;
    }


    .navegacao a {

        width: 32px;
        height: 32px;
    }
}


