* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --preto: #090708;
    --preto-claro: #120e10;
    --vinho: #721c32;
    --vinho-claro: #9d2947;
    --rosa: #c96a82;
    --branco: #f8f3f4;
    --cinza: #b9afb2;
}

body {
    background: var(--preto);
    color: var(--branco);
    font-family: "Poppins", sans-serif;
}

/* HEADER */

header {
    width: 100%;
    position: absolute;
    top: 0;
    z-index: 10;
}

nav {
    width: 85%;
    max-width: 1200px;
    margin: auto;
    padding: 28px 0;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: "Cormorant Garamond", serif;
    font-size: 34px;
    letter-spacing: 1px;
}

.logo span,
footer span {
    color: var(--vinho-claro);
}

nav ul {
    display: flex;
    gap: 35px;
    list-style: none;
}

nav a {
    color: var(--branco);
    text-decoration: none;
    font-size: 14px;
    transition: 0.3s;
}

nav a:hover {
    color: var(--rosa);
}


/* HERO */

.hero {
    min-height: 100vh;
    padding: 150px 8% 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background:
        radial-gradient(circle at 80% 50%, #551326 0%, transparent 28%),
        var(--preto);

    overflow: hidden;
}

.hero-text {
    max-width: 650px;
}

.pequeno {
    color: var(--rosa);
    font-size: 12px;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

h1 {
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(55px, 7vw, 90px);
    line-height: 0.95;
    font-weight: 600;
}

h1 span {
    color: var(--vinho-claro);
    font-style: italic;
}

.descricao {
    color: var(--cinza);
    max-width: 500px;
    margin: 30px 0;
    line-height: 1.8;
}

.botao {
    display: inline-block;
    background: var(--vinho);
    color: white;
    text-decoration: none;

    padding: 14px 28px;
    border-radius: 3px;

    transition: 0.3s;
}

.botao:hover {
    background: var(--vinho-claro);
    transform: translateY(-3px);
}


/* DECORAÇÃO */

.hero-decoration {
    width: 380px;
    height: 380px;

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.circulo {
    width: 320px;
    height: 320px;

    border-radius: 50%;

    background: linear-gradient(
        145deg,
        var(--vinho-claro),
        #2b0a14
    );

    box-shadow:
        0 0 80px rgba(157, 41, 71, 0.3),
        inset 0 0 50px rgba(0, 0, 0, 0.4);
}

.nome {
    position: absolute;

    font-family: "Cormorant Garamond", serif;
    font-size: 70px;
    font-weight: bold;
    letter-spacing: 8px;

    transform: rotate(-90deg);

    color: rgba(255,255,255,0.08);
}


/* SEÇÕES */

section {
    padding: 110px 8%;
}

.titulo p {
    color: var(--rosa);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.titulo h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: 60px;
}

.titulo h2 span {
    color: var(--vinho-claro);
    font-style: italic;
}

.sobre-conteudo {
    max-width: 1100px;
    margin: 60px auto 0;

    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 80px;

    align-items: center;
}

.foto {
    width: 300px;
    height: 380px;

    background:
        linear-gradient(
            145deg,
            var(--vinho),
            #17090d
        );

    border: 1px solid #6e2638;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow: 20px 20px 0 #241016;
}

.inicial {
    font-family: "Cormorant Garamond", serif;
    font-size: 180px;
    color: rgba(255,255,255,0.12);
}

.texto h3 {
    font-family: "Cormorant Garamond", serif;
    font-size: 40px;
    margin-bottom: 20px;
}

.texto p {
    color: var(--cinza);
    line-height: 1.9;
    margin-bottom: 18px;
}

.texto strong {
    color: var(--rosa);
}


/* GOSTOS */

.gostos {
    background: var(--preto-claro);
}

.centralizado {
    text-align: center;
}

.cards {
    max-width: 1100px;
    margin: 60px auto 0;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    padding: 40px 30px;

    background: #0d090b;
    border: 1px solid #28171d;

    transition: 0.4s;
}

.card:hover {
    transform: translateY(-10px);
    border-color: var(--vinho);
    box-shadow: 0 15px 40px rgba(114, 28, 50, 0.2);
}

.icone {
    font-size: 35px;
    color: var(--rosa);
    margin-bottom: 25px;
}

.card h3 {
    font-family: "Cormorant Garamond", serif;
    font-size: 32px;
    margin-bottom: 15px;
}

.card p {
    color: var(--cinza);
    line-height: 1.7;
    font-size: 14px;
    margin-bottom: 25px;
}

.tag {
    color: var(--rosa);
    font-size: 10px;
    letter-spacing: 3px;
}


/* FRASE */

.frase {
    min-height: 400px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            rgba(9, 7, 8, 0.85),
            rgba(9, 7, 8, 0.95)
        ),
        radial-gradient(circle, #64182f, #090708);
}

.frase div {
    max-width: 750px;
}

.frase span {
    color: var(--vinho-claro);
    font-family: Georgia, serif;
    font-size: 100px;
    line-height: 0;
}

.frase p {
    font-family: "Cormorant Garamond", serif;
    font-size: 42px;
    font-style: italic;
    line-height: 1.2;
}

.frase small {
    display: block;
    margin-top: 25px;
    color: var(--rosa);
}


/* FOOTER */

footer {
    padding: 50px 8%;
    text-align: center;

    background: #060506;
    border-top: 1px solid #24151b;
}

footer h2 {
    font-family: "Cormorant Garamond", serif;
    font-size: 35px;
}

footer p {
    color: var(--cinza);
    font-size: 13px;
    margin-top: 8px;
}

footer .copyright {
    margin-top: 25px;
    color: #675c60;
}


/* RESPONSIVO */

@media (max-width: 800px) {

    nav {
        width: 90%;
    }

    nav ul {
        gap: 15px;
    }

    nav a {
        font-size: 12px;
    }

    .hero {
        padding: 130px 7% 80px;
        text-align: center;
    }

    .hero-text {
        margin: auto;
    }

    .descricao {
        margin: 25px auto;
    }

    .hero-decoration {
        display: none;
    }

    .titulo h2 {
        font-size: 48px;
    }

    .sobre-conteudo {
        grid-template-columns: 1fr;
        gap: 50px;
    }

    .foto {
        margin: auto;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .frase p {
        font-size: 32px;
    }
}

@media (max-width: 500px) {

    nav ul {
        display: none;
    }

    h1 {
        font-size: 52px;
    }

    section {
        padding: 80px 7%;
    }
}
