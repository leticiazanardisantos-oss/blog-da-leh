/* =========================================
   CORES E FONTES
========================================= */

:root {

    --preto: #080608;
    --preto-suave: #120b0f;

    --vinho-escuro: #3a0b1c;
    --vinho: #701b38;
    --vinho-medio: #8f2347;
    --vinho-claro: #bd4d70;

    --branco: #fff8fa;
    --cinza: #d9c5cc;

    --borda: rgba(189, 77, 112, 0.35);

    --fonte-titulo: "DM Serif Display", serif;
    --fonte-texto: "Poppins", sans-serif;
}


/* =========================================
   CONFIGURAÇÕES GERAIS
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;

    scroll-behavior: smooth;
}


body {
    min-width: 320px;

    overflow-x: hidden;

    background: var(--preto);

    color: var(--branco);

    font-family: var(--fonte-texto);
}


/* =========================================
   SLIDES
========================================= */

.slide {
    position: relative;

    min-height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 90px 10%;

    overflow: hidden;
}


.conteudo,
.titulo,
.sobre-box,
.musica-conteudo,
.filmes,
.final {
    position: relative;

    z-index: 2;
}


/* =========================================
   NÚMERO DOS SLIDES
========================================= */

.numero {
    position: absolute;

    top: 40px;

    right: 8%;

    z-index: 3;

    color: var(--vinho-claro);

    font-size: 13px;

    letter-spacing: 4px;

    opacity: 0.85;
}


/* =========================================
   TEXTOS
========================================= */

.subtitulo {
    margin-bottom: 20px;

    color: var(--vinho-claro);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 4px;
}


h1,
h2,
h3 {
    font-family: var(--fonte-titulo);

    font-weight: 400;
}


h1 {
    max-width: 720px;

    font-size: clamp(3.5rem, 8vw, 6.5rem);

    line-height: 0.95;
}


h1 span,
h2 span {
    display: block;

    margin-top: 10px;

    color: var(--vinho-claro);

    font-style: italic;
}


h2 {
    font-size: clamp(3rem, 6vw, 4.8rem);

    line-height: 1;
}


h3 {
    color: var(--branco);
}


.descricao {
    max-width: 570px;

    margin: 30px 0;

    color: var(--cinza);

    line-height: 1.8;
}


/* =========================================
   BOTÕES
========================================= */

.botao {
    display: inline-block;

    padding: 14px 28px;

    border: 1px solid var(--vinho-claro);

    border-radius: 50px;

    background: var(--vinho);

    color: var(--branco);

    font-size: 14px;

    font-weight: 600;

    text-decoration: none;

    transition: 0.3s ease;
}


.botao:hover {
    transform: translateY(-5px);

    background: var(--vinho-claro);

    color: var(--preto);

    box-shadow:
        0 12px 35px rgba(189, 77, 112, 0.3);
}


/* =========================================
   SLIDE 1
========================================= */

.slide1 {

    justify-content: flex-start;

    background:

        radial-gradient(
            circle at 80% 30%,
            rgba(143, 35, 71, 0.35),
            transparent 25%
        ),

        radial-gradient(
            circle at 20% 80%,
            rgba(112, 27, 56, 0.3),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            var(--preto),
            var(--vinho-escuro),
            var(--preto-suave)
        );
}


/* =========================================
   DECORAÇÃO DO SLIDE 1
========================================= */

.decoracao {
    position: absolute;

    right: 5%;

    width: 450px;

    height: 450px;
}


.circulo {
    position: absolute;

    border-radius: 50%;
}


.circulo1 {

    top: 50px;

    right: 20px;

    width: 350px;

    height: 350px;

    background:

        linear-gradient(
            135deg,
            var(--vinho-medio),
            var(--vinho-escuro)
        );

    box-shadow:

        0 0 90px rgba(143, 35, 71, 0.35),

        inset -25px -25px 60px rgba(0, 0, 0, 0.45);

    animation: flutuar 6s ease-in-out infinite;
}


.circulo2 {

    top: 0;

    right: 0;

    width: 170px;

    height: 170px;

    background: var(--vinho-claro);

    opacity: 0.55;

    filter: blur(5px);

    animation: flutuar 5s ease-in-out infinite reverse;
}


.estrela {

    position: absolute;

    bottom: 50px;

    left: 30px;

    color: var(--vinho-claro);

    font-size: 80px;

    animation: girar 10s linear infinite;
}


/* =========================================
   SLIDE 2
========================================= */

.slide2 {

    flex-direction: column;

    background:

        radial-gradient(
            circle at 90% 90%,
            rgba(112, 27, 56, 0.4),
            transparent 32%
        ),

        linear-gradient(
            135deg,
            var(--preto-suave),
            var(--vinho-escuro)
        );
}


.titulo {

    width: 100%;

    max-width: 1100px;

    margin-bottom: 50px;
}


.sobre-box {

    width: 100%;

    max-width: 1100px;

    display: grid;

    grid-template-columns: 350px 1fr;

    gap: 80px;

    align-items: center;
}


/* =========================================
   FOTO
========================================= */

.foto {

    width: 300px;

    height: 380px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 2px solid var(--borda);

    border-radius: 150px 150px 25px 25px;

    background:

        linear-gradient(
            145deg,
            var(--vinho-medio),
            var(--vinho-escuro),
            var(--preto)
        );

    box-shadow:

        20px 20px 0 rgba(112, 27, 56, 0.35),

        0 25px 70px rgba(0, 0, 0, 0.45);
}


.foto span {

    color: rgba(255, 248, 250, 0.16);

    font-family: var(--fonte-titulo);

    font-size: 190px;
}


.texto h3 {

    margin-bottom: 20px;

    font-size: 38px;
}


.texto p {

    margin-bottom: 18px;

    color: var(--cinza);

    line-height: 1.8;
}


.texto strong {

    color: var(--vinho-claro);
}


/* =========================================
   SLIDE 3 - MÚSICA
========================================= */

.slide3 {

    background:

        radial-gradient(
            circle at 30% 50%,
            rgba(112, 27, 56, 0.45),
            transparent 36%
        ),

        linear-gradient(
            120deg,
            var(--preto),
            var(--vinho-escuro),
            #240913
        );
}


.musica-conteudo {

    width: 100%;

    max-width: 950px;
}


.musica-conteudo h2 {

    margin-bottom: 45px;
}


.musica-card {

    max-width: 750px;

    display: flex;

    align-items: center;

    gap: 30px;

    margin-bottom: 35px;

    padding: 35px;

    border: 1px solid var(--borda);

    border-radius: 22px;

    background: rgba(255, 255, 255, 0.055);

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.25);

    backdrop-filter: blur(12px);
}


.icone-musica {

    min-width: 100px;

    height: 100px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background:

        linear-gradient(
            135deg,
            var(--vinho-claro),
            var(--vinho-escuro)
        );

    color: var(--branco);

    font-size: 55px;

    box-shadow:
        0 0 35px rgba(189, 77, 112, 0.25);
}


.mini {

    margin-bottom: 5px;

    color: var(--vinho-claro);

    font-size: 10px;

    letter-spacing: 3px;
}


.musica-card h3 {

    margin-bottom: 8px;

    font-size: 45px;
}


.musica-card p {

    color: var(--cinza);

    line-height: 1.7;
}


.musica-card strong {

    color: var(--vinho-claro);
}


/* =========================================
   ONDAS DE MÚSICA
========================================= */

.ondas {

    position: absolute;

    right: 10%;

    bottom: 0;

    z-index: 1;

    height: 180px;

    display: flex;

    align-items: flex-end;

    gap: 8px;

    opacity: 0.7;
}


.ondas span {

    width: 12px;

    border-radius: 20px 20px 0 0;

    background: var(--vinho-claro);

    animation:
        onda 1s ease-in-out infinite alternate;
}


.ondas span:nth-child(1) {
    height: 50px;
}

.ondas span:nth-child(2) {
    height: 100px;
    animation-delay: .2s;
}

.ondas span:nth-child(3) {
    height: 70px;
    animation-delay: .3s;
}

.ondas span:nth-child(4) {
    height: 140px;
    animation-delay: .4s;
}

.ondas span:nth-child(5) {
    height: 90px;
    animation-delay: .5s;
}

.ondas span:nth-child(6) {
    height: 160px;
    animation-delay: .6s;
}

.ondas span:nth-child(7) {
    height: 80px;
    animation-delay: .7s;
}

.ondas span:nth-child(8) {
    height: 130px;
    animation-delay: .8s;
}


/* =========================================
   SLIDE 4 - FILMES
========================================= */

.slide4 {

    flex-direction: column;

    background:

        radial-gradient(
            circle at 50% 100%,
            rgba(112, 27, 56, 0.55),
            transparent 40%
        ),

        var(--preto-suave);
}


.centralizado {

    text-align: center;
}


.centralizado .descricao {

    margin: 15px auto 0;
}


.filmes {

    width: 100%;

    max-width: 950px;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 30px;

    margin-bottom: 40px;
}


.filme-card {

    position: relative;

    min-height: 300px;

    padding: 40px;

    overflow: hidden;

    border: 1px solid var(--borda);

    border-radius: 25px;

    transition: 0.4s ease;
}


.filme-card:hover {

    transform: translateY(-10px);

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.5);
}


.acao {

    background:

        linear-gradient(
            135deg,
            var(--vinho),
            var(--preto)
        );
}


.romance {

    background:

        linear-gradient(
            135deg,
            var(--vinho-medio),
            var(--vinho-escuro)
        );
}


.filme-icone {

    margin-bottom: 20px;

    font-size: 50px;
}


.filme-card h3 {

    margin-bottom: 15px;

    font-size: 45px;
}


.filme-card p {

    color: var(--cinza);

    line-height: 1.7;
}


/* =========================================
   SLIDE FINAL
========================================= */

.slide5 {

    background:

        radial-gradient(
            circle at center,
            var(--vinho),
            var(--vinho-escuro) 48%,
            var(--preto) 100%
        );
}


.final {

    max-width: 800px;

    text-align: center;
}


.aspas {

    height: 100px;

    color: var(--vinho-claro);

    font-family: var(--fonte-titulo);

    font-size: 130px;

    line-height: 1;
}


.final h2 {

    font-size: clamp(3rem, 6vw, 4.8rem);
}


.final p {

    max-width: 600px;

    margin: 25px auto;

    color: var(--cinza);

    font-size: 18px;

    line-height: 1.7;
}


.linha {

    width: 100px;

    height: 2px;

    margin: 30px auto;

    background: var(--vinho-claro);
}


.final h3 {

    margin-bottom: 30px;

    font-size: 28px;
}


/* =========================================
   NAVEGAÇÃO
========================================= */

.navegacao {

    position: fixed;

    top: 50%;

    right: 25px;

    z-index: 100;

    display: flex;

    flex-direction: column;

    gap: 12px;

    transform: translateY(-50%);
}


.navegacao a {

    width: 38px;

    height: 38px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid rgba(255, 248, 250, 0.3);

    border-radius: 50%;

    background: rgba(58, 11, 28, 0.7);

    color: var(--branco);

    font-size: 10px;

    text-decoration: none;

    transition: 0.3s ease;

    backdrop-filter: blur(8px);
}


.navegacao a:hover {

    transform: scale(1.15);

    border-color: var(--vinho-claro);

    background: var(--vinho-claro);

    color: var(--preto);
}


/* =========================================
   ANIMAÇÕES
========================================= */

@keyframes girar {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}


@keyframes flutuar {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-18px);
    }
}


@keyframes onda {

    from {
        transform: scaleY(0.55);
    }

    to {
        transform: scaleY(1);
    }
}


/* =========================================
   RESPONSIVIDADE
========================================= */

@media (max-width: 900px) {

    .slide {
        padding: 90px 8%;
    }


    .decoracao {
        right: -120px;

        opacity: 0.45;
    }


    .sobre-box {

        grid-template-columns: 1fr;

        gap: 50px;

        text-align: center;
    }


    .foto {
        margin: auto;
    }


    .titulo {
        text-align: center;
    }


    .filmes {

        grid-template-columns: 1fr;
    }


    .ondas {

        right: 5%;

        opacity: 0.25;
    }
}


@media (max-width: 600px) {

    .slide {

        min-height: 100svh;

        padding: 80px 7%;
    }


    h1 {

        font-size: 3.5rem;
    }


    h2 {

        font-size: 3rem;
    }


    .numero {

        top: 25px;

        right: 7%;
    }


    .navegacao {

        right: 10px;

        gap: 8px;
    }


    .navegacao a {

        width: 32px;

        height: 32px;
    }


    .foto {

        width: 240px;

        height: 300px;
    }


    .foto span {

        font-size: 140px;
    }


    .musica-card {

        flex-direction: column;

        padding: 28px 22px;

        text-align: center;
    }


    .musica-card h3 {

        font-size: 40px;
    }


    .filme-card {

        min-height: 250px;

        padding: 30px;
    }


    .filme-card h3 {

        font-size: 40px;
    }


    .aspas {

        font-size: 100px;
    }
}



