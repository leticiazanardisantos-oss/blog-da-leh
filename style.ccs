/* Configurações gerais */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f0ff;
    color: #333;
    line-height: 1.6;
}


/* Cabeçalho */

header {
    background: linear-gradient(135deg, #7b2cbf, #c77dff);
    color: white;
    text-align: center;
    padding: 60px 20px;
}

header h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
}


/* Menu */

nav {
    background-color: #4a148c;
    display: flex;
    justify-content: center;
    gap: 30px;
    padding: 18px;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #e0aaff;
}


/* Conteúdo */

main {
    width: 90%;
    max-width: 1000px;
    margin: 40px auto;
}

.card {
    background-color: white;
    padding: 35px;
    margin-bottom: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
}

.card h2 {
    color: #7b2cbf;
    text-align: center;
    margin-bottom: 25px;
    font-size: 30px;
}


/* Seção sobre */

.conteudo {
    display: flex;
    align-items: center;
    gap: 40px;
}

.foto img {
    width: 250px;
    height: 250px;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid #c77dff;
}

.texto {
    flex: 1;
}

.texto p {
    margin-bottom: 15px;
}


/* Cards de hobbies */

.cards {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.item {
    background: #f3e5f5;
    padding: 25px;
    border-radius: 12px;
    width: 280px;
    text-align: center;
    transition: 0.3s;
}

.item:hover {
    transform: translateY(-8px);
    background-color: #e1bee7;
}

.item h3 {
    color: #7b2cbf;
    margin-bottom: 10px;
}


/* Lista de qualidades */

ul {
    list-style: none;
    max-width: 500px;
    margin: auto;
}

li {
    background-color: #f3e5f5;
    margin: 10px 0;
    padding: 12px;
    border-radius: 8px;
    font-size: 18px;
}


/* Mensagem */

.mensagem {
    background-color: #7b2cbf;
    color: white;
    padding: 20px;
    margin-top: 20px;
    border-radius: 10px;
    text-align: center;
    font-style: italic;
    font-size: 18px;
}


/* Rodapé */

footer {
    background-color: #4a148c;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
}


/* Responsividade para celular */

@media (max-width: 700px) {

    header h1 {
        font-size: 30px;
    }

    nav {
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .conteudo {
        flex-direction: column;
        text-align: center;
    }

    .foto img {
        width: 200px;
        height: 200px;
    }

    .card {
        padding: 25px 15px;
    }
}
